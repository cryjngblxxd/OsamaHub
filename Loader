    local currentStatusText = (Loader.SelectedGame and Loader.SelectedGame.Status) or "Undetected"
    local currentStatusColor = STATUS_COLORS[currentStatusText] or Theme.TextColor
    local _, statusValueLabel = CreateInfoRow(infoContent, "Status", currentStatusText, currentStatusColor, 6)
    Loader.StatusLabel = statusValueLabel

    CreateSectionHeader(infoContent, "ADDITIONAL INFO", 7)

    local execName, execSupported, execStatus = GetExecutorInfo()
    local execColor = execSupported and Theme.Success or Theme.Error
    CreateInfoRow(infoContent, "Executor", execName.." ("..execStatus..")", execColor, 8)

    local _, keyTimeLabel = CreateInfoRow(infoContent, "Key Time", "Not checked", Theme.TextDim, 9)
    Loader.KeyTimeLabels[1] = keyTimeLabel


    Connect(getKeyBtn.MouseLeave, function() Tween(getKeyBtn, {BackgroundTransparency = 0.85}, 0.15) end)
    Connect(getKeyBtn.MouseButton1Click, function()
        if setclipboard then
            setclipboard(KEY_LINK)
            CreateNotification(screenGui, "Copied", "Key link copied to clipboard", "Success", 3)
        else
            CreateNotification(screenGui, "Error", "Clipboard not available", "Error", 3)
        end
    end)

    local checkKeyBtn = Create("TextButton", {Parent = infoContent, BackgroundColor3 = Theme.Gradient, BorderSizePixel = 0, Size = UDim2.new(1,0,0,30), Text = "Check Key", TextColor3 = Theme.TextColor, TextSize = 13, AutoButtonColor = false, LayoutOrder = 3})
    ApplyFont(checkKeyBtn, false)

    local checking = false
    Connect(checkKeyBtn.MouseButton1Click, function()
        if checking then return end
        local key = keyInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if not key or key == "" then
            CreateNotification(screenGui, "Empty Key", "Please enter a key first", "Warning", 3)
            Loader.KeyValid = false
            HideInjectSection()
            return
        end
        if #key ~= KEY_LENGTH then
            CreateNotification(screenGui, "Invalid Key", "Key must be "..KEY_LENGTH.." characters", "Error", 3)
            Loader.KeyValid = false
            HideInjectSection()
            return
        end
        if not Loader.SelectedGame then
            CreateNotification(screenGui, "No Game Selected", "Select a game from the list before checking your key", "Warning", 4)
            return
        end
        if Loader.SelectedGame.ScriptId == "SCRIPT_ID_HERE" or not Loader.SelectedGame.ScriptId or Loader.SelectedGame.ScriptId == "" then
            CreateNotification(screenGui, "Script Not Ready", Loader.SelectedGame.Name.." is not yet configured", "Warning", 3)
            return
        end
        checking = true
        checkKeyBtn.Text = "Checking..."
        ValidateKey(key, Loader.SelectedGame.ScriptId, function(success, message, data)
            checking = false
            checkKeyBtn.Text = "Check Key"
            if success then
                Loader.KeyValid = true
                Loader.ValidatedKey = key
                Loader.ValidatedScriptId = Loader.SelectedGame.ScriptId
                local expiryText = FormatExpiry(data)
                if Loader.KeyTimeLabels[1] then
                    Loader.KeyTimeLabels[1].Text = expiryText
                    Loader.KeyTimeLabels[1].TextColor3 = expiryText == "Expired" and Theme.Error or Theme.Success
                end
                CreateNotification(screenGui, "Key Valid", "Expires: "..expiryText, "Success", 3)
                if Loader.SelectedGame then ShowInjectSection() else CreateNotification(screenGui, "No Game", "Please select a game from the list", "Warning", 3) end
            else
                Loader.KeyValid = false
                Loader.ValidatedKey = nil
                Loader.ValidatedScriptId = nil
                if Loader.KeyTimeLabels[1] then
                    Loader.KeyTimeLabels[1].Text = "Invalid"
                    Loader.KeyTimeLabels[1].TextColor3 = Theme.Error
                end
                CreateNotification(screenGui, "Key Check Failed", message or "Invalid key", "Error", 3)
                HideInjectSection()
            end

    local injectBtn = Create("TextButton", {Parent = injectSection, BackgroundColor3 = Theme.InjectBg, BorderSizePixel = 0, Size = UDim2.new(1,0,1,0), Text = "INJECT", TextColor3 = Theme.InjectText, TextSize = 15, AutoButtonColor = false})
    ApplyFont(injectBtn, true)
    Create("UIStroke", {Parent = injectBtn, Color = Theme.Outline, Thickness = 1, Name = "BtnStroke"})

    Connect(injectBtn.MouseButton1Click, function()
        if not Loader.InjectVisible then return end
        local key = Loader.ValidatedKey or keyInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if not Loader.KeyValid or #key ~= KEY_LENGTH then
            CreateNotification(screenGui, "Error", "Verify your key first", "Warning", 3)
            return
        end
        if not Loader.SelectedGame then
            CreateNotification(screenGui, "Error", "Select a game first", "Warning", 3)
            return
        end
        if not execSupported then
            CreateNotification(screenGui, "Unsupported", "Your executor is not supported", "Error", 3)
            return
        end
        local expectedGameId = nil
        for gId, gData in pairs(SUPPORTED_GAMES) do
            if gData == Loader.SelectedGame then expectedGameId = gId break end
        end
        if expectedGameId and expectedGameId ~= game.GameId then
            CreateNotification(screenGui, "Wrong Game", "You are not in "..Loader.SelectedGame.Name, "Error", 4)
            task.wait(2)
            LocalPlayer:Kick("Wrong game. Please join "..Loader.SelectedGame.Name..".")
            return
        end
        CreateNotification(screenGui, "Loading", "Fetching script", "Info", 2)
        task.wait(0.5)
        LoadGameScript(Loader.SelectedGame.ScriptId, key)
    end)

    local currentGameId = game.GameId
    local order = 1

    for gameId, gameData in pairs(SUPPORTED_GAMES) do
        if gameData.ShowInUI == true then
            local btn, setSelected
            btn, setSelected = CreateGameButton(gameList, gameData.Name, gameData.Icon, order, function()
                for _, info in pairs(Loader.GameButtons) do info.setSelected(false) end
                setSelected(true)
                Loader.SelectedGame = gameData
                Loader.InfoTitle.Text = gameData.Name
                if Loader.StatusLabel then
                    local status = gameData.Status or "Undetected"
                    Loader.StatusLabel.Text = status
                    Loader.StatusLabel.TextColor3 = STATUS_COLORS[status] or Theme.TextColor
                end
                if Loader.LastUpdateLabels[1] then
                    Loader.LastUpdateLabels[1].Text = "Loading..."
                    Loader.LastUpdateLabels[1].TextColor3 = Theme.TextDim
                    FetchLastUpdate(gameData.GitHubPath, function(relativeTime)
                        if Loader.LastUpdateLabels[1] and Loader.LastUpdateLabels[1].Parent then
                            Loader.LastUpdateLabels[1].Text = relativeTime
                            Loader.LastUpdateLabels[1].TextColor3 = Theme.TextColor
                        end
                    end)
                end
                if Loader.KeyValid and Loader.ValidatedScriptId ~= gameData.ScriptId then
                    Loader.KeyValid = false
                    Loader.ValidatedKey = nil
                    Loader.ValidatedScriptId = nil
                    if Loader.KeyTimeLabels[1] then
                        Loader.KeyTimeLabels[1].Text = "Not checked"
                        Loader.KeyTimeLabels[1].TextColor3 = Theme.TextDim
                    end
                    HideInjectSection()
                elseif Loader.KeyValid then
                    ShowInjectSection()
                end
            end)
            Loader.GameButtons[gameId] = {btn = btn, setSelected = setSelected}
            order = order + 1
        end
    end

    if SUPPORTED_GAMES[currentGameId] and SUPPORTED_GAMES[currentGameId].ShowInUI == true then
        local info = Loader.GameButtons[currentGameId]
        if info then
            info.setSelected(true)
            Loader.SelectedGame = SUPPORTED_GAMES[currentGameId]
            Loader.InfoTitle.Text = SUPPORTED_GAMES[currentGameId].Name
            if Loader.StatusLabel then
                local status = SUPPORTED_GAMES[currentGameId].Status or "Undetected"
                Loader.StatusLabel.Text = status
                Loader.StatusLabel.TextColor3 = STATUS_COLORS[status] or Theme.TextColor
            end
            FetchLastUpdate(SUPPORTED_GAMES[currentGameId].GitHubPath, function(relativeTime)
                if Loader.LastUpdateLabels[1] and Loader.LastUpdateLabels[1].Parent then
                    Loader.LastUpdateLabels[1].Text = relativeTime
                    Loader.LastUpdateLabels[1].TextColor3 = Theme.TextColor
                end
            end)
        end
    end

    main.Size = UDim2.new(0,580,0,0)
    main.BackgroundTransparency = 1
    Tween(main, {Size = UDim2.new(0,580,0,440), BackgroundTransparency = 0}, 0.4)

    task.delay(0.5, function()
        if not Loader.Destroyed then
            local gameName = (SUPPORTED_GAMES[currentGameId] and SUPPORTED_GAMES[currentGameId].ShowInUI) and SUPPORTED_GAMES[currentGameId].Name or "Unsupported"
            CreateNotification(screenGui, "OsamaHub Loader", "Game: "..gameName, "Success", 4)
        end
    end)
end

local existingLoader = CoreGui:FindFirstChild("OsamaHubLoader")
if existingLoader then existingLoader:Destroy() end

local preloadedKey = (getgenv and getgenv().lp_key) or _G.lp_key
local currentGameId = game.GameId
local currentGameData = SUPPORTED_GAMES[currentGameId]

if preloadedKey and type(preloadedKey) == "string" and #preloadedKey == KEY_LENGTH and currentGameData and currentGameData.ScriptId and currentGameData.ScriptId ~= "SCRIPT_ID_HERE" then
    ValidateKey(preloadedKey, currentGameData.ScriptId, function(success, message, data)
        if success then
            local expiry = data and tonumber(data.expire)
            local isExpired = expiry and expiry < 0

            if isExpired then
                CreateLoaderUI()
                task.wait(0.3)
                if Loader.KeyInput then
                    Loader.KeyInput.Text = preloadedKey
                end
                Loader.KeyValid = false
                Loader.ValidatedKey = nil
                Loader.ValidatedScriptId = nil
                if Loader.KeyTimeLabels[1] then
                    Loader.KeyTimeLabels[1].Text = "Expired"
                    Loader.KeyTimeLabels[1].TextColor3 = Theme.Error
                end
                task.wait(0.6)
                CreateNotification(Loader.GUI, "Key Expired", "Your key has expired, please get a new one", "Error", 6)
            else
                LoadGameScript(currentGameData.ScriptId, preloadedKey)
            end
        else
            CreateLoaderUI()
            task.wait(0.3)
            if Loader.KeyInput then
                Loader.KeyInput.Text = preloadedKey
            end
            Loader.KeyValid = false
            Loader.ValidatedKey = nil
            Loader.ValidatedScriptId = nil
            if Loader.KeyTimeLabels[1] then
                Loader.KeyTimeLabels[1].Text = "Invalid"
                Loader.KeyTimeLabels[1].TextColor3 = Theme.Error
            end
            task.wait(0.6)
            CreateNotification(Loader.GUI, "Key Check Failed", message or "Please verify your key", "Error", 6)
        end
    end)
else
    CreateLoaderUI()
    if preloadedKey and type(preloadedKey) == "string" and #preloadedKey == KEY_LENGTH then
        task.wait(0.3)
        if Loader.KeyInput then
            Loader.KeyInput.Text = preloadedKey
        end
    end
    if preloadedKey and currentGameData == nil then
        task.wait(0.6)
        if Loader.GUI then
            CreateNotification(Loader.GUI, "Unsupported Game", "This game is not supported by OsamaHub", "Error", 5)
        end
    end
end

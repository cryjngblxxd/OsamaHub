local function CreateAnimatedGradient(parent, thickness, horizontal)
    thickness = thickness or 1
    horizontal = horizontal ~= false
    local line = Create("Frame", {Parent = parent, BackgroundColor3 = Color3.fromRGB(255,255,255), BorderSizePixel = 0, Size = horizontal and UDim2.new(1,0,0,thickness) or UDim2.new(0,thickness,1,0), ZIndex = 5})
    local topGradient = Create("UIGradient", {Parent = line, Color = ColorSequence.new(TopLineConfig.gradient.color1, TopLineConfig.gradient.color2), Rotation = horizontal and 0 or 90})
    local gradientTime = math.random() * 10
    local NUM_POINTS = 7
    local pointSeeds = {}
    for i = 1, NUM_POINTS do
        pointSeeds[i] = {freqA=0.3+math.random()*0.7, freqB=0.2+math.random()*0.5, phaseA=math.random()*math.pi*2, phaseB=math.random()*math.pi*2}
    end
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not line.Parent then conn:Disconnect() return end
        if not TopLineConfig.gradient.enabled then return end
        gradientTime = gradientTime + dt * TopLineConfig.gradient.speed
        local c1, c2 = TopLineConfig.gradient.color1, TopLineConfig.gradient.color2
        local keypoints = {}
        for i = 1, NUM_POINTS do
            local t = (i-1)/(NUM_POINTS-1)
            local seed = pointSeeds[i]
            local blend = math.clamp(0.5 + 0.5 * math.sin(gradientTime*seed.freqA+seed.phaseA) * math.cos(gradientTime*seed.freqB*0.7+seed.phaseB), 0, 1)
            table.insert(keypoints, ColorSequenceKeypoint.new(t, Color3.new(c1.R+(c2.R-c1.R)*blend, c1.G+(c2.G-c1.G)*blend, c1.B+(c2.B-c1.B)*blend)))
        end
        topGradient.Color = ColorSequence.new(keypoints)
    end)
    table.insert(Loader.Connections, conn)
    return line
end


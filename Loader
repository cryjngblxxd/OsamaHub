        Parent   = Inner,
    })

    local function Follow()
        local Mouse  = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
        local Bounds = UI.ScreenGui.AbsoluteSize
        local X      = Mouse.X + 14
        local Y      = Mouse.Y + 16

      
        if X + Width > Bounds.X then X = Mouse.X - Width - 6 end
        if Y + 20 > Bounds.Y then Y = Mouse.Y - 26 end

        Outer.Position = UDim2.fromOffset(X, Y)
    end

    Connect(Props.Target.MouseEnter, function()
        Follow()
        Outer.Visible = true
    end)

    
    Connect(Props.Target.MouseMoved, Follow)

    Connect(Props.Target.MouseLeave, function()
        Outer.Visible = false
    end)

    return Outer
end


local function MakeProgress(Props)
    local Bar = {}

    local Track = New("Frame", {
        BackgroundColor3 = Theme.OutlineColor,
        BorderSizePixel  = 0,
        Position         = Props.Position,
        Size             = Props.Size,
        ZIndex           = Props.ZIndex or 6,
        Parent           = Props.Parent,
    })

    local Fill = New("Frame", {
        BackgroundColor3 = Theme.AccentColor,
        BorderSizePixel  = 0,
        Size             = UDim2.new(0, 0, 1, 0),
        ZIndex           = (Props.ZIndex or 6) + 1,
        Parent           = Track,
    })

    local Current

    local function Tween(Scale, Time, Style)
        if Current then Current:Cancel() end

        Current = TweenService:Create(
            Fill,
            TweenInfo.new(Time, Style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Size = UDim2.new(Scale, 0, 1, 0)}
        )

        Current:Play()
    end

    function Bar:Start()
        Fill.BackgroundColor3 = Theme.AccentColor
        Fill.Size = UDim2.new(0, 0, 1, 0)
        Tween(0.9, 1.6)
    end

    function Bar:Finish(Good)
        Fill.BackgroundColor3 = Good and Theme.GoodColor or Theme.RiskColor
        Tween(1, 0.18)

        task.delay(0.9, function()
            Tween(0, 0.25)
        end)
    end

    function Bar:Reset()
        Tween(0, 0.15)
    end

    return Bar
end



local function CollectFade(Root)
    local Targets = {}

    local function Add(Inst)
        if Inst:IsA("GuiObject") then
            table.insert(Targets, {Inst, "BackgroundTransparency", Inst.BackgroundTransparency})
        end

        if Inst:IsA("TextLabel") or Inst:IsA("TextBox") or Inst:IsA("TextButton") then
            table.insert(Targets, {Inst, "TextTransparency", Inst.TextTransparency})
        end

        if Inst:IsA("ImageLabel") or Inst:IsA("ImageButton") then
            table.insert(Targets, {Inst, "ImageTransparency", Inst.ImageTransparency})
        end

        if Inst:IsA("UIStroke") then
            table.insert(Targets, {Inst, "Transparency", Inst.Transparency})
        end
    end

    Add(Root)

    for _, Desc in ipairs(Root:GetDescendants()) do
        Add(Desc)
    end

    return Targets
end

local function FadeTo(Targets, Alpha, Time)
    local Info = TweenInfo.new(Time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    for _, Entry in ipairs(Targets) do
        local Inst, Prop, Base = Entry[1], Entry[2], Entry[3]

        pcall(function()
            TweenService:Create(Inst, Info, {[Prop] = 1 - ((1 - Base) * Alpha)}):Play()
        end)
    end
end


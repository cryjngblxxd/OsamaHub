local function New(Class, Props, Children)
    local Inst = Instance.new(Class)

    for Prop, Value in pairs(Props or {}) do
        if Prop ~= "Parent" then Inst[Prop] = Value end
    end

    for _, Child in ipairs(Children or {}) do
        Child.Parent = Inst
    end

    if Props and Props.Parent then Inst.Parent = Props.Parent end

    return Inst
end

local function Connect(Signal, Fn)
    local Conn = Signal:Connect(Fn)
    table.insert(UI.Connections, Conn)
    return Conn
end

--// Every bit of text in the file goes through here, so the black 1px stroke is never forgotten + aura 
local function Text(Props)
    local Label = New(Props.Class or "TextLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        FontFace               = FontFace,
        Text                   = Props.Text or "",
        TextColor3             = Props.Color or Theme.FontColor,
        TextSize               = Props.Size or 12,
        TextXAlignment         = Props.XAlign or Enum.TextXAlignment.Left,
        TextTransparency       = Props.Transparency or 0,
        Position               = Props.Position or UDim2.new(),
        Size                   = Props.Frame or UDim2.new(1, 0, 1, 0),
        ZIndex                 = Props.ZIndex or 5,
        Parent                 = Props.Parent,
    })

    New("UIStroke", {
        Color         = Theme.Black,
        Thickness     = 1,
        LineJoinMode  = Enum.LineJoinMode.Miter,
        Transparency  = Props.Transparency or 0,
        Parent        = Label,
    })

    return Label
end

local function TextWidth(Str, Size)
    local Ok, Bounds = pcall(function()
        return TextService:GetTextSize(Str, Size, Enum.Font.Code, Vector2.new(math.huge, math.huge))
    end)

    return Ok and Bounds.X or (#Str * Size * 0.5)
end


if type(preloadedKey) == "string" and #preloadedKey == KEY_LENGTH and currentGame and currentGame.ScriptId ~= "SCRIPT_ID_HERE" then
    CheckBar:Start()

    EnsureKey(preloadedKey, currentGame.ScriptId, function(ok, _, data)
        if UI.Unloaded then return end

        if ok then
            local Expiry = tonumber(data and data.expire)

            if not (Expiry and Expiry < 0) then
                LoaderState.ValidatedKey = preloadedKey
                CheckBar:Finish(true)
                ExecuteScript(currentGame.ScriptId, preloadedKey, true)
                return
            end
        end

        CheckBar:Reset()
    end)
end

local function HexToColor(Hex)
    local N = tonumber(Hex, 16)

    if not N then return nil end

    return Color3.fromRGB(bit32.band(bit32.rshift(N, 16), 255), bit32.band(bit32.rshift(N, 8), 255), bit32.band(N, 255))
end


do
    local Keys = {"FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor"}

    local function Apply(Fields)
        for Index, Key in ipairs(Keys) do
            local Color = HexToColor(((Fields[Index] or ""):gsub("#", "")))

            if Color then Theme[Key] = Color end
        end
    end

    pcall(function()
        local Root = "LinoraSettings/themes/"

        if not (isfile and isfile(Root .. "default.txt")) then return end

        local Name = readfile(Root .. "default.txt"):gsub("^%s+", ""):gsub("%s+$", "")

        if Palettes[Name] then
            Apply(Palettes[Name]:split(","))
            return
        end

        --// A theme the user saved themselves is a json blob rather than one of the built in names dis retarded but works 
        if isfile(Root .. Name .. ".txt") then
            local Custom = HttpService:JSONDecode(readfile(Root .. Name .. ".txt"))
            local Fields = {}

            for Index, Key in ipairs(Keys) do
                Fields[Index] = Custom[Key]
            end

            Apply(Fields)
        end
    end)
end



local function ValidateKey(key, scriptId, callback)
    if type(scriptId) == "function" then
        callback = scriptId
        scriptId = nil
    end

    scriptId = tostring(scriptId or ""):gsub("%s", "")
    key = tostring(key or ""):gsub("%s", "")

    if scriptId == "" or scriptId == "SCRIPT_ID_HERE" then
        callback(false, "No valid script selected", nil)
        return
    end

    task.spawn(function()
        local success, result = pcall(function()
            local sdk = loadstring(game:HttpGet("https://sdk.luaprot.net/"))()
            sdk.scriptId = scriptId
            return sdk:checkKey(key)
        end)

        if success and result and result.status == "VALID" then
            callback(true, "Valid", result.data)
        else
            callback(false, (result and result.message) or "Invalid Key", nil)
        end
    end)
end

local function LoadGameScript(scriptId, key)
    PrepareForGameScript()
    _G.lp_key = key
    if getgenv then getgenv().lp_key = key end
    pcall(function()
        local c = (http and http.request) or request
        local o = {"eu-1","eu-2","us-1"}
        local h, k = pcall(function() return c({Url = "https://eu-1.luaprot.net/api/v1/nodes/get"}) end)
        if h and k and k.StatusCode == 200 then
            local b
            pcall(function() b = HttpService:JSONDecode(k.Body) end)
            if b and b.success and b.node then
                for i, n in pairs(o) do
                    if n == b.node then table.remove(o, i) table.insert(o, 1, b.node) break end
                end
            end
        end
        for _, p in pairs(o) do
            local y
            pcall(function()
                y = c({Url = "https://"..p..".luaprot.net/api/v2/loader/get?key="..key.."&scriptId="..scriptId})
            end)
            if y and (y.StatusCode == 200 or y.StatusCode == 201) then
                local b = loadstring(y.Body)
                if b then b(p) break end
            end
        end
    end)
end


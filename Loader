local function ValidateKey(key, scriptId, callback)
    scriptId = tostring(scriptId or ""):gsub("%s", "")
    key = tostring(key or ""):gsub("%s", "")

    if scriptId == "" or scriptId == "SCRIPT_ID_HERE" then
        callback(false, "No valid script selected", nil)
        return
    end

    task.spawn(function()
        local success, result = pcall(function()
            local sdk = GetSdk()

            if not sdk then return nil end

            sdk.scriptId = scriptId
            return sdk:checkKey(key)
        end)

        if success and result and result.status == "VALID" then
            callback(true, "Valid", result.data)
        else
            callback(false, (result and result.message) or "Invalid Key", nil)
        end
    end)
end


local function VerdictKey(key, scriptId)
    return tostring(key) .. "|" .. tostring(scriptId)
end

local function EnsureKey(key, scriptId, callback)
    local Cached = LoaderState.Checked[VerdictKey(key, scriptId)]

    if Cached then
        callback(Cached.Ok, Cached.Message, Cached.Data)
        return
    end

    ValidateKey(key, scriptId, function(ok, message, data)
        LoaderState.Checked[VerdictKey(key, scriptId)] = {Ok = ok, Message = message, Data = data}
        callback(ok, message, data)
    end)
end


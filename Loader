        UI:Notify("A key is exactly " .. KEY_LENGTH .. " characters, yours is " .. #Key, 4)
        return
    end

    local Order = {}

    if currentGame and currentGame.ScriptId then
        table.insert(Order, currentGame.ScriptId)
    end

    for _, Entry in ipairs(GameList) do
        if Entry.Data.ScriptId ~= (currentGame and currentGame.ScriptId) then
            table.insert(Order, Entry.Data.ScriptId)
        end
    end

    if #Order == 0 then
        UI:Notify("No script is configured to check against", 4)
        return

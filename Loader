    Checking = true
    CheckBar:Start()
    UI:Notify("Checking your key", 2)

    task.spawn(function()
        for _, ScriptId in ipairs(Order) do
            local Done, Ok, Message, Data = false, false, nil, nil

            EnsureKey(Key, ScriptId, function(a, b, c)
                Ok, Message, Data = a, b, c
                Done = true
            end)

            local Deadline = os.clock() + 15

            while not Done and os.clock() < Deadline do
                task.wait(0.05)
            end

            if not Done then Message = "the key server did not answer" end

            if Ok then
                local Expiry = tonumber(Data and Data.expire)

                if Expiry and Expiry < 0 then
                    Checking = false
                    CheckBar:Finish(false)
                    UI:Notify("That key has expired", 4)
                    return
                end

                LoaderState.ValidatedKey = Key
                Checking = false
                CheckBar:Finish(true)
                UI:Notify("Key accepted, expiry " .. FormatExpiry(Data), 4)

                task.wait(0.7)
                KeyWindow:Destroy()
                BuildPicker()
                return
            end

          
            if ScriptId == Order[#Order] then
                Checking = false
                CheckBar:Finish(false)
                UI:Notify("Key rejected: " .. tostring(Message or "invalid key"), 5)
                return
            end
        end

        Checking = false
        CheckBar:Finish(false)
    end)

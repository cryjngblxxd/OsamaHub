local function SafeHttpGet(url, retries)
    retries = retries or 3
    for i = 1, retries do
        local success, result = pcall(function() return game:HttpGet(url) end)
        if success and result and result ~= "" then return true, result end
        if i < retries then task.wait(0.5) end
    end
    return false, "Failed to fetch"
end

local function FormatRelativeTime(isoDate)
    if not isoDate or isoDate == "" then return "Unknown" end
    local year, month, day, hour, min, sec = isoDate:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)Z")
    if not year then return "Unknown" end
    local commitTime = os.time({year=tonumber(year),month=tonumber(month),day=tonumber(day),hour=tonumber(hour),min=tonumber(min),sec=tonumber(sec)})
    local diff = math.max(0, os.time(os.date("!*t")) - commitTime)
    if diff < 60 then return diff <= 1 and "just now" or (diff.." seconds ago")
    elseif diff < 3600 then local m=math.floor(diff/60) return m==1 and "1 minute ago" or m.." minutes ago"
    elseif diff < 86400 then local h=math.floor(diff/3600) return h==1 and "1 hour ago" or h.." hours ago"
    elseif diff < 604800 then local d=math.floor(diff/86400) return d==1 and "1 day ago" or d.." days ago"
    elseif diff < 2592000 then local w=math.floor(diff/604800) return w==1 and "1 week ago" or w.." weeks ago"
    elseif diff < 31536000 then local mo=math.floor(diff/2592000) return mo==1 and "1 month ago" or mo.." months ago"
    else local y=math.floor(diff/31536000) return y==1 and "1 year ago" or y.." years ago" end
end

local function FormatExpiry(data)
    if not data then return "Unknown" end
    local s = tonumber(data.expire)
    if not s or s == 0 then return "Lifetime" end
    if s < 0 then return "Expired" end
    if s < 60 then return s.."s left"
    elseif s < 3600 then return math.floor(s/60).."m left"
    elseif s < 86400 then return math.floor(s/3600).."h left"
    elseif s < 2592000 then return math.floor(s/86400).."d left"
    elseif s < 31536000 then return math.floor(s/2592000).."mo left"
    else return math.floor(s/31536000).."y left" end
end

local function FetchLastUpdate(filePath, callback)
    if Loader.UpdateCache[filePath] then callback(Loader.UpdateCache[filePath]) return end
    task.spawn(function()
        local apiUrl = string.format("https://api.github.com/repos/%s/%s/commits?path=%s&per_page=1", GITHUB_REPO_OWNER, GITHUB_REPO_NAME, filePath)
        local success, response = SafeHttpGet(apiUrl, 2)
        if not success or not response then callback("Unknown") return end
        local ok, data = pcall(function() return HttpService:JSONDecode(response) end)
        if not ok or not data or #data == 0 then callback("Unknown") return end
        local commit = data[1]
        if commit and commit.commit and commit.commit.author and commit.commit.author.date then
            local rel = FormatRelativeTime(commit.commit.author.date)
            Loader.UpdateCache[filePath] = rel
            callback(rel)
        else callback("Unknown") end
    end)
end


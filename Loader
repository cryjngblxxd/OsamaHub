function UI:Unload()
    if self.Unloaded then return end

    self.Unloaded = true

    for _, Conn in ipairs(self.Connections) do
        pcall(function() Conn:Disconnect() end)
    end

    table.clear(self.Connections)
    pcall(function() self.ScreenGui:Destroy() end)
end

--// drag functionalties 
local function MakeDraggable(Frame, Cutoff)
    Frame.Active = true

    Connect(Frame.InputBegan, function(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local Start  = Frame.AbsolutePosition
        local Grab   = Vector2.new(Input.Position.X - Start.X, Input.Position.Y - Start.Y)

        if Grab.Y > (Cutoff or 25) then return end

      
        Frame.AnchorPoint = Vector2.zero
        Frame.Position    = UDim2.fromOffset(Start.X, Start.Y)

        local Move, State

        local function Stop()
            if Move then Move:Disconnect() Move = nil end
            if State then State:Disconnect() State = nil end
        end

        Move = UserInputService.InputChanged:Connect(function(Changed)
            local Wanted = Input.UserInputType == Enum.UserInputType.Touch
                and Enum.UserInputType.Touch
                or Enum.UserInputType.MouseMovement

            if Changed.UserInputType ~= Wanted then return end

            Frame.Position = UDim2.fromOffset(Changed.Position.X - Grab.X, Changed.Position.Y - Grab.Y)
        end)

        State = Input:GetPropertyChangedSignal("UserInputState"):Connect(function()
            if Input.UserInputState == Enum.UserInputState.End or Input.UserInputState == Enum.UserInputState.Cancel then
                Stop()
            end
        end)

        if Input.UserInputState == Enum.UserInputState.End then Stop() end
    end)
end

